<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buat &amp; Edit Dokumen"
        android:textColor="@color/ink_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDocName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_bar"
        android:hint="Nama file (tanpa ekstensi)"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/ink_primary"
        android:textColorHint="@color/ink_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDocContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_hairline"
        android:gravity="top|start"
        android:hint="Tulis teks, catatan, atau Markdown (# Judul, **tebal**, - daftar)..."
        android:inputType="textMultiLine"
        android:lineSpacingMultiplier="1.35"
        android:padding="14dp"
        android:textColor="@color/ink_primary"
        android:textColorHint="@color/ink_secondary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveMd"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Simpan .MD"
            android:textColor="@color/ink_primary"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportPdf"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent"
            android:text="Ekspor PDF"
            android:textColor="@color/on_accent"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
